# Vanzameteo - configurazione Apache (Altervista)

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Per forzare HTTPS (dopo averlo attivato dal pannello Altervista) togli il commento:
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # File e cartelle esistenti (es. /foicam/...) vengono serviti così come sono.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tutte le altre richieste vanno all'app Angular (routing lato client).
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html e config.json devono essere sempre aggiornati.
  <FilesMatch "^(index\.html|config\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # I bundle hanno l'hash nel nome: si possono tenere in cache a lungo.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
